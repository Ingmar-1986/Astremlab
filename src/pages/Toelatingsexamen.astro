        "Werk in drie tot zes weken intensief aan je belangrijkste werkpunten, met zes individuele sessies, coaching, feedback en WhatsApp-begeleiding.",
      href: "#astrem-sprint",
      label: "Bekijk ASTREM Sprint"
    }
  };

  const buttons = document.querySelectorAll("[data-result]");
  const title = document.querySelector("[data-choice-title]");
  const text = document.querySelector("[data-choice-text]");
  const link = document.querySelector("[data-choice-link]");
  const resultBox = document.querySelector("[data-choice-result]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const result = recommendations[button.dataset.result];
      if (!result || !title || !text || !link || !resultBox) return;

      buttons.forEach((item) => {
        item.classList.remove("is-selected");
        item.setAttribute("aria-pressed", "false");
      });

      button.classList.add("is-selected");
      button.setAttribute("aria-pressed", "true");

      title.textContent = result.title;
      text.textContent = result.text;
      link.textContent = result.label;
      link.href = result.href;

      resultBox.classList.add("has-result");
    });
  });
