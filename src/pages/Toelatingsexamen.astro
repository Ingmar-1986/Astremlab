        "Start met een grondige niveaubepaling en ontvang een persoonlijk rapport, studieadvies en voorstel voor het best passende traject.",
      href: "#astrem-scan",
      label: "Bekijk ASTREM Scan"
    },
    coaching: {
      title: "ASTREM Coaching",
      text:
        "Je behoudt je bestaande cursus, maar krijgt een persoonlijke coach voor planning, opvolging, proefexamens en examenstrategie.",
      href: "#astrem-coaching",
      label: "Bekijk ASTREM Coaching"
    },
    vak: {
      title: "ASTREM Vaktraject",
      text:
        "Kies wiskunde, fysica, chemie of biologie en werk met twaalf individuele lessen doelgericht aan dat ene KIW-vak.",
      href: "#astrem-vaktraject",
      label: "Bekijk het Vaktraject"
    },
    combi: {
      title: "ASTREM Combi",
      text:
        "Combineer twee KIW-vakken naar keuze met vierentwintig individuele lessen, coaching, proefexamens en twee simulatie-examens.",
      href: "#astrem-combi",
      label: "Bekijk ASTREM Combi"
    },
    premium: {
      title: "ASTREM Premium Med",
      text:
        "Kies voor volledige begeleiding in wiskunde, fysica, chemie en biologie, met intensieve coaching en persoonlijke opvolging.",
      href: "#astrem-premium",
      label: "Bekijk Premium Med"
    },
    sprint: {
      title: "ASTREM Sprint",
      text:
        "Werk in een kort en intensief traject aan je belangrijkste tekorten en oefen gericht onder examenomstandigheden.",
      href: "#astrem-sprint",
      label: "Bekijk ASTREM Sprint"
    }
  };

  const buttons = document.querySelectorAll("[data-result]");
  const title = document.querySelector("[data-choice-title]");
  const text = document.querySelector("[data-choice-text]");
  const link = document.querySelector("[data-choice-link]");
  const resultBox = document.querySelector("[data-choice-result]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const result = recommendations[button.dataset.result];

      buttons.forEach((item) => {
        item.classList.remove("is-selected");
        item.setAttribute("aria-pressed", "false");
      });

      button.classList.add("is-selected");
      button.setAttribute("aria-pressed", "true");

      title.textContent = result.title;
      text.textContent = result.text;
      link.textContent = result.label;
      link.href = result.href;

      resultBox.classList.add("has-result");
    });
  });
</script>

