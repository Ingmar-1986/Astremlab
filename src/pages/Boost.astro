---
import BaseLayout from "../layouts/BaseLayout.astro";
---


<BaseLayout title="ASTREM BOOST | ASTREM Lab">
  <main id="top" class="boost-page">
    <section class="boost-hero section-pad">
      <div class="container boost-hero-grid">
        <div class="boost-hero-text">
          <p class="eyebrow">ASTREM BOOST</p>
          <h1>Een persoonlijk traject voor duurzame vooruitgang.</h1>
          <p class="hero-lead">
            BOOST is geen losse bijles, maar een doelgericht begeleidingstraject
            voor leerlingen en studenten die intensief willen groeien in wiskunde,
            fysica, statistiek, programmeren of STEM.
          </p>

          <div class="hero-actions">
            <a href="/#contact" class="btn btn-primary">Plan je kennismaking</a>
            <a href="/tarieven" class="btn btn-secondary">Bekijk tarieven</a>
          </div>
        </div>

        <div class="boost-hero-card">
          <span class="boost-label">Meest gekozen</span>
          <h2>BOOST-traject</h2>
          <p>
            Intensieve sessies met opvolging, extra oefeningen en een plan dat
            past bij jouw niveau, doelen en planning.
          </p>
          <ul>
            <li>1-op-1 of kleine groep</li>
            <li>Online of fysiek in Bellegem</li>
            <li>Tussentijdse ondersteuning</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="boost-intro section-pad-sm">
      <div class="container narrow-container">
        <p class="section-tag">Waarom BOOST?</p>
        <h2>Voor wie meer nodig heeft dan één losse uitleg.</h2>
        <p>
          BOOST-sessies bouwen een breder leertraject op langere termijn uit.
          De focus ligt op inzicht, denkstrategieën en zelfstandigheid. Je werkt
          niet alleen aan oefeningen, maar ook aan de manier waarop je leerstof
          begrijpt, verwerkt en toepast.
        </p>
        <p>
          Wil je vooral één concrete oefening of een klein stukje leerstof laten
          uitleggen? Dan past ASTREM Bijles beter. BOOST is bedoeld voor wie
          stap voor stap sterker wil worden in één of meerdere thema’s.
        </p>
      </div>
    </section>

    <section class="boost-for section-pad">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Ideaal voor</p>
          <h2>Wanneer kies je voor BOOST?</h2>
        </div>

        <div class="boost-check-grid">
          <article>
            <span>01</span>
            <h3>Examens en herexamens</h3>
            <p>Gericht voorbereiden op toetsen, examens, starttoetsen of toelatingsexamens.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Inzicht en structuur</h3>
            <p>Moeilijke leerstof opnieuw helder krijgen via een logische stap-voor-stap aanpak.</p>
          </article>

          <article>
            <span>03</span>
            <h3>STEM-vakken</h3>
            <p>Trajectmatig groeien in wiskunde, fysica, statistiek, programmeren en natuurwetenschappen.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Zelfstandiger leren</h3>
            <p>Leren plannen, redeneren, toepassen en zelfstandig aan de slag gaan.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="boost-practical section-pad-sm">
      <div class="container boost-practical-grid">
        <div>
          <p class="eyebrow">Praktisch</p>
          <h2>Intensief, persoonlijk en flexibel.</h2>
          <p>
            Een BOOST-sessie duurt meestal 1,5 à 2 uur. Na het lesmoment krijg je
            opdrachten of oefeningen om zelfstandig te verwerken. Daardoor blijft
            elke sessie efficiënt en is er meer ruimte voor verdieping.
          </p>
        </div>

        <div class="boost-info-list">
          <div>
            <strong>Individueel</strong>
            <span>€50/u, met korting bij trajecten van 5 of 10 lessen.</span>
          </div>
          <div>
            <strong>Kleine groep</strong>
            <span>2 à 3 leerlingen vanaf €40/u per persoon.</span>
          </div>
          <div>
            <strong>Locatie</strong>
            <span>Online met interactief whiteboard of fysiek in Bellegem bij Kortrijk.</span>
          </div>
          <div>
            <strong>Opvolging</strong>
            <span>Tussentijdse ondersteuning via WhatsApp of e-mail.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="boost-process section-pad">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Aanpak</p>
          <h2>Zo verloopt een BOOST-traject.</h2>
        </div>

        <div class="process-timeline">
          <article>
            <span>1</span>
            <h3>Kennismaking</h3>
            <p>We luisteren naar je noden, doelen en planning.</p>
          </article>

          <article>
            <span>2</span>
            <h3>Plan van aanpak</h3>
            <p>We bepalen welke leerstof, oefeningen en strategieën nodig zijn.</p>
          </article>

          <article>
            <span>3</span>
            <h3>BOOST-sessies</h3>
            <p>We werken intensief aan inzicht, structuur en toepassing.</p>
          </article>

          <article>
            <span>4</span>
            <h3>Opvolging</h3>
            <p>Je krijgt gerichte opdrachten en feedback tussen de lessen door.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="boost-quote-section">
      <div class="container">
        <blockquote class="boost-quote">
          <p>
            “We stippelen samen een traject uit dat écht bij je past:
            concreet, haalbaar en aangepast aan jouw niveau.”
          </p>
        </blockquote>
      </div>
    </section>

    <section class="cta section-pad">
      <div class="container cta-box">
        <p class="eyebrow">Start je BOOST-traject</p>
        <h2>Klaar om doelgericht vooruit te gaan?</h2>
        <p>
          Stuur een mail of plan een kennismaking. Dan bekijken we samen welk traject
          het best aansluit bij jouw situatie.
        </p>
        <div class="hero-actions center-actions">
          <a href="mailto:info@astremlab.be" class="btn btn-primary">Mail ASTREM Lab</a>
          <a href="/#contact" class="btn btn-secondary">Plan een kennismaking</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
